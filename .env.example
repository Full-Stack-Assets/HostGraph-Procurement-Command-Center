# OAuth Configuration
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Analytics (optional)
# Example: https://analytics.example.com
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Google Maps API (via Forge)
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# HostGraph vendor adapter contract
# Never commit real account IDs or tokens. Configure only from vendor-authorized
# integration documentation and account credentials.
# Replace <PREFIX> with the normalized vendor ID, e.g. SYSCO_BOSTON.
HOSTGRAPH_VENDOR_<PREFIX>_BASE_URL=
HOSTGRAPH_VENDOR_<PREFIX>_READ_PATH=
HOSTGRAPH_VENDOR_<PREFIX>_ACCOUNT_ID=
HOSTGRAPH_VENDOR_<PREFIX>_AUTH_KIND=BEARER
HOSTGRAPH_VENDOR_<PREFIX>_TOKEN=
HOSTGRAPH_VENDOR_<PREFIX>_AUTH_HEADER=X-API-Key
HOSTGRAPH_VENDOR_<PREFIX>_AUTHORIZATION_BASIS=VENDOR_API

# Release manifest integrity. Required only for REGIONAL_DATA_READY or later.
HOSTGRAPH_RELEASE_HMAC_KEY=
